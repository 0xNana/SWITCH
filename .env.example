# Frontend wallet RPC. The public testnet endpoint is the default if omitted.
NEXT_PUBLIC_EVM_RPC=https://test-evm-rpc-v3.portaldot.dev
NEXT_PUBLIC_SWITCH_ADDRESS=0x4c9c0836Be052cE08436E912fcEaB218Ce51e29f
NEXT_PUBLIC_API_URL=
NOTIFICATION_SERVER_URL=http://localhost:3001

# Backend. Set SWITCH_ADDRESS to the deployment printed by the Foundry script.
EVM_RPC=https://test-evm-rpc-v3.portaldot.dev
CHAIN_ID=420420777
SWITCH_ADDRESS=0x4c9c0836Be052cE08436E912fcEaB218Ce51e29f
EXPLORER_URL=https://scanner-testnet-v3.portaldot.dev
NOTIFICATION_SERVER_PORT=3001
ALLOWED_ORIGINS=http://localhost:5173

# Optional email notifications. Use a sender domain verified with Resend.
RESEND_API_KEY=
EMAIL_FROM="SWITCH <notifications@example.com>"
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Deployment signer; keep the real value in an ignored .env file or secret store.
PRIVATE_KEY=
